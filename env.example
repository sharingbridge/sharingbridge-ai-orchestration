PORT=8091
AI_ORCHESTRATION_INTERNAL_API_KEY=

# deterministic = no external LLM (CI default)
# live = Groq (text) + Gemini (vision) — see sharingbridge/development/AI_IMPLEMENTATION_PLAN.md
AI_LLM_MODE=deterministic

# Groq — suggest-vendors + instruction-pack compose (text only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini — reference photo vision (image_description, seeker_appearance_hints)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# Signed photo URLs for vision step (same stack as mobile PHOTO_SERVICE_BASE_URL)
PHOTO_SERVICE_BASE_URL=http://localhost:8092

# OpenStreetMap Nominatim reverse geocode (no API key — set a real contact in User-Agent)
NOMINATIM_USER_AGENT=SharingBridge-AI-Orchestration/1.0 (you@example.com)

# Courier instruction text only (not an API URL).
SHARINGBRIDGE_WEBSITE_URL=pending

# Logging: error | warn (default) | info | debug — warn = issues only at startup
LOG_LEVEL=warn

# Legacy — not used in Gemini+Groq split
# OPENAI_API_KEY=
# AI_LLM_MODEL=gpt-4o-mini
